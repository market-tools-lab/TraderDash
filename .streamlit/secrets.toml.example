# Copy this file to .streamlit/secrets.toml and edit it there.
# secrets.toml is gitignored. Do not commit real values.
#
# Local development (SQLite):
#   environment = "local"
#   database_url = ""
#
# Streamlit Community Cloud (Supabase Postgres):
#   environment = "production"
#   database_url = "postgresql://..."
#
# database_url is the Supabase Postgres connection string from
# Project Settings → Database. Use the session pooler URI.
# It is read only by the Streamlit server.
#
# Do not put the Supabase service-role key, a database password,
# a preview URL or a preview key in this file.
# The legacy app uses environment and database_url.
# The Auth pilot uses the three TRADERDASH_ names and not database_url.
# Leave those three commented on the legacy app.

environment = "local"
database_url = ""
# TRADERDASH_AUTH_MODE = "supabase_auth"
# TRADERDASH_SUPABASE_URL = ""
# TRADERDASH_SUPABASE_ANON_KEY = ""

# Optional path for the local SQLite file. Ignored in production.
database_path = ""
